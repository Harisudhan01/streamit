  GET_CATALOG_VARIABLES: 'Get Catalog Variables from {0}',
  ASK_FOR_APPROVAL: 'Ask For Approval on {0}',
  WAIT_FOR_CONDITION: 'Wait For {0} Condition',
  SEND_NOTIFICATION: 'Send Notification [{0}]',
  LOG: 'Log {0}'
};
