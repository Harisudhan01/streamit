  UPDATE_RECORD: 'Update {0} Record',
  DELETE_RECORD: 'Delete {0} Record',
  CREATE_OR_UPDATE_RECORD: 'Create or Update {0} Record',
  UPDATE_MULTIPLE_RECORDS: 'Update Multiple {0} Records',
  CREATE_TASK: 'Create {0} Task',
