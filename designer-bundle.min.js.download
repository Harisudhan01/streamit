/* Config JSON format . Same must be copied and modified according to the action to support natural language summary for
 {
     "<action_name>" : {
         "summarizable_inputs" : {
            "<input_name>" : {
                 "type" : "<Type of the input>",
                 "dependent_on" : "<Input on which the current input depends on.Eg . Record type input depends on table type input>",
                 "summarizable_key" : "<Empty if the key is string and the value is directly summarizable . Else mention the key path within the input object of action instance object. No dotwalk level support>"
             }
         },
		   "summary_template" : "<Template for the summary of the action.The value of each input_name replaces the respective placeholder. Eg. 'Look Up {0} Record', {0} is replaced with the table value to be>"
     }
 }
	 
*/
